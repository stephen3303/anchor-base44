{
  "name": "MessageUserState",
  "type": "object",
  "properties": {
    "message_id": {
      "type": "string"
    },
    "message_reference": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "read_at": {
      "type": "string"
    },
    "starred": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "message_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}