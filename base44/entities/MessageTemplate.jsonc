{
  "name": "MessageTemplate",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "template_class": {
      "type": "string",
      "enum": [
        "basic",
        "standard"
      ]
    },
    "message_type": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "guidance": {
      "type": "string"
    },
    "include_references": {
      "type": "boolean",
      "default": false
    },
    "default_subject": {
      "type": "string"
    },
    "default_action_addressees": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "default_paragraphs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "paragraph_prompts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "trigger_use": {
      "type": "string",
      "enum": [
        "both",
        "draft",
        "validate"
      ],
      "default": "both"
    },
    "tag_message_types": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tag_originators": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tag_communities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tag_precedence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tag_subject_keywords": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tag_body_keywords": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name",
    "template_class"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}