{
  "name": "NetworkLink",
  "type": "object",
  "properties": {
    "link_key": {
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "state": {
      "type": "string",
      "enum": [
        "up",
        "down"
      ],
      "default": "up"
    },
    "note": {
      "type": "string"
    },
    "reported_by_name": {
      "type": "string"
    },
    "reported_by_email": {
      "type": "string"
    },
    "reported_at": {
      "type": "string"
    }
  },
  "required": [
    "link_key",
    "state"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}