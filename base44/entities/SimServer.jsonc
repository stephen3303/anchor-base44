{
  "name": "SimServer",
  "type": "object",
  "properties": {
    "server": {
      "type": "string",
      "enum": [
        "c2oix",
        "local"
      ]
    },
    "label": {
      "type": "string"
    },
    "online": {
      "type": "boolean",
      "default": true
    },
    "feed_active": {
      "type": "boolean",
      "default": false
    },
    "beats": {
      "type": "number",
      "default": 0
    },
    "received": {
      "type": "number",
      "default": 0
    },
    "last_beat_at": {
      "type": "string"
    },
    "peer_state": {
      "type": "string"
    },
    "peer_beat_at": {
      "type": "string"
    },
    "peer_latency_ms": {
      "type": "number"
    },
    "last_error": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "updated_by_name": {
      "type": "string"
    }
  },
  "required": [
    "server"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}