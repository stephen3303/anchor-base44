{
  "name": "Subscription",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "frequency": {
      "type": "string",
      "enum": [
        "real_time",
        "daily",
        "weekly"
      ],
      "default": "real_time"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "pending",
        "denied",
        "paused"
      ],
      "default": "pending"
    },
    "mandatory": {
      "type": "boolean",
      "default": false
    },
    "channels": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "criteria_types": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "criteria_communities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "criteria_precedence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "justification": {
      "type": "string"
    },
    "requested_by_name": {
      "type": "string"
    },
    "requested_by_email": {
      "type": "string"
    },
    "approver_name": {
      "type": "string"
    },
    "decision_comment": {
      "type": "string"
    },
    "decided_at": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}